# ==============================================================================
# OcuGuard AI Middleware Engine - Environment Configurations (.env)
# Copy this file to '.env' and populate with actual credentials before deploying.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Security & Server Settings
# ------------------------------------------------------------------------------
# Server bind configurations
OCUGUARD_API_HOST=0.0.0.0
OCUGUARD_API_PORT=8000

# CORS origins (comma-separated list of allowed hardware web consoles)
OCUGUARD_CORS_ORIGINS=*

# JSON Web Token (JWT) secret verification key (Replace in Production!)
OCUGUARD_JWT_SECRET=super-secret-signature-key-change-this-for-production-deployment

# Mock Bearer tokens allowed for stateless authentication testing (comma-separated)
OCUGUARD_MOCK_TOKENS=tenant_apple,tenant_meta,tenant_magic,tenant_research,tenant_default

# ------------------------------------------------------------------------------
# 2. Hardware Vendor Rate Limits (Tokens Bucket: Rate per sec, Burst Capacity)
# ------------------------------------------------------------------------------
# Key value pairs structured in JSON to optimize routing limits per hardware vendor.
# Format: {"vendor_id": [replenish_rate_per_sec, bucket_token_capacity]}
OCUGUARD_VENDOR_LIMITS={"apple": [1.666, 10.0], "meta": [1.333, 10.0], "magic": [0.833, 5.0], "default": [1.0, 10.0]}

# ------------------------------------------------------------------------------
# 3. Google Gemini / LLM Integration Settings
# ------------------------------------------------------------------------------
# API Key for Google AI Studio / Gemini models (Required for AI features)
GEMINI_API_KEY=YOUR_SECURE_GEMINI_API_KEY_HERE

# Google AI Studio model name (e.g. gemini-2.5-flash or gemini-2.5-pro)
OCUGUARD_LLM_MODEL=gemini-2.5-flash

# Maximum time in seconds to wait for AI response before triggering failure cascade
OCUGUARD_LLM_TIMEOUT=2.0

# ------------------------------------------------------------------------------
# 4. Clinical Spatial Pathology Thresholds (Degrees)
# ------------------------------------------------------------------------------
# Retinal Gas Bubble (Face-down posture bounds)
OCUGUARD_RETINAL_PITCH_MIN=-90.0
OCUGUARD_RETINAL_PITCH_MAX=-55.0

# Cataract Post-Op ( waist-bending restrictions)
OCUGUARD_CATARACT_PITCH_MIN=-45.0
OCUGUARD_CATARACT_PITCH_MAX=45.0

# Glaucoma Post-Op (Upright stable pressure limits)
OCUGUARD_GLAUCOMA_PITCH_MIN=-20.0
OCUGUARD_GLAUCOMA_VIOLATION_LIMIT=-30.0
OCUGUARD_GLAUCOMA_CONSECUTIVE_LOOPS=3

# Conservative Fallback (Standard default protection for undefined conditions)
OCUGUARD_CONSERVATIVE_PITCH_MIN=-20.0
OCUGUARD_CONSERVATIVE_ROLL_LIMIT=30.0
